<HStack>
    <StickyStack>
        <Pad Sides="Side.TopBottom">
            <Paper Color="ColorLayer.Layer3">
                <Pad>
                    <VStack>
                        @for (var i = 1; i <= 30; i++)
                        {
                            var j = i;
                            <Button Style="Style.Glass">@j</Button>
                        }
                    </VStack>
                </Pad>
            </Paper>
        </Pad>
    </StickyStack>
    <VStack>
        @for (var i = 1; i <= 100; i++)
        {
            var j = i;
            <Button Style="Style.Glass">@j</Button>
        }
    </VStack>
</HStack>
