<VStack>
    @foreach (var stackBehaviour in Enum.GetValues<StackBehaviour>())
    {
        <HStack StackBehaviour="stackBehaviour">
            <StackWeight Weight="null">
                <Button Size="Size.Small">Left</Button>
            </StackWeight>
            <StackWeight Weight="null">
                <Button>Center</Button>
            </StackWeight>
            <StackWeight Weight="null">
                <Button Size="Size.Large">Right</Button>
            </StackWeight>
        </HStack>
    }
</VStack>