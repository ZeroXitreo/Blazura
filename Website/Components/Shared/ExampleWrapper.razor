@inject IWebHostEnvironment env

<Paper>
    <Pad>
        <VStack>
            <DynamicComponent Type="Type" />
            <Paper Color="ColorLayer.Layer3">
                <Accordion Title="@(isCodeOpen ? "Hide code" : "Show code")" OnToggle="CodeToggled">
                    <CodeBlock>@(GetCodeBlock())</CodeBlock>
                </Accordion>
            </Paper>
        </VStack>
    </Pad>
</Paper>

<Paper>
    <Pad>
        <VStack>
            <DynamicComponent Type="Type" />
            <Paper Color="ColorLayer.Layer3">
                <Accordion Title="@(isCodeOpen ? "Hide code" : "Show code")" OnToggle="CodeToggled">
                    <CodeBlock>@(GetCodeBlock())</CodeBlock>
                </Accordion>
            </Paper>
        </VStack>
    </Pad>
</Paper>

@code {
    [Parameter, EditorRequired]
    public string Folder { get; set; }

    [Parameter, EditorRequired]
    public Type Type { get; set; }

    private string GetCodeBlock() => File.ReadAllText(Path.Combine(env.ContentRootPath, "Components", "Examples", Folder, $"{Type.Name}.razor"));

    private bool isCodeOpen = false;

    private async Task CodeToggled(bool isOpen)
    {
        isCodeOpen = isOpen;
    }
}
