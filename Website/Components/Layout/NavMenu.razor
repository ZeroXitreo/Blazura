<nav class="nav">
    <VStack Spacing="Spacing.Xxs">
        @foreach (var category in linkCategories)
        {
            <h3 style="font-size: .75rem;
                font-weight: 700;
                text-transform: uppercase;
                padding: 1rem;
                opacity: .5;">
                @category.Key
            </h3>
            @foreach (var navLink in category.Value)
            {
                <NavLink href="@navLink.Value">
                    <SimpleButton Style="Style.Clear" Size="Size.Large">
                        <HStack StackBehaviour="StackBehaviour.Left">
                            <StackWeight Weight="null">
                                <span>@navLink.Key</span>
                            </StackWeight>
                        </HStack>
                    </SimpleButton>
                </NavLink>
            }
        }
    </VStack>
</nav>

@code {
    private Dictionary<string, Dictionary<string, string>> linkCategories = new()
    {
        { "General", new()
            {
                { "Home", "" },
            }
        },
        { "Fundamentals", new()
            {
                { "Stacks", "stacks" },
            }
        },
        { "Basics", new()
            {
                { "Banner", "banner" },
                { "Chip", "chip" },
                { "Badge", "badge" },
                { "Stacks", "stacks" },
                { "Lightbox", "lightbox" },
                { "Context Menu", "contextmenu" },
                { "File Collection", "filecollection" },
                { "Progress", "progress" },
