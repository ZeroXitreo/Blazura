@using Blazura.Components.Layout
@inherits LayoutComponentBase
@layout RootLayout

@implements IDisposable
@inject NavigationManager NavigationManager

<div class="page @(isMenuOpen ? "toggle" : "")">
    <aside class="@(isMenuOpen ? "toggle" : "")">
        <div class="SlinkyScroll">
            <Pad>
                <VStack>
                    <Pad>
                        <Header />
                    </Pad>
                    <NavMenu />
                    <Pad>
                        <Footer />
                    </Pad>
                </VStack>
            </Pad>
        </div>
    </aside>
    <div>
        <Pad Sizing="Sizing.Lg">
            <HStack HeightAlignment="HeightAlignment.Center" StackBehaviour="StackBehaviour.Seperate">
                <StackWeight Weight="null">
                    <div class="sideMenuButton">
                        <IconButton Icon="menu" @onclick="Open" />
                    </div>
                </StackWeight>
                <StackWeight Weight="null">
                    <HStack HeightAlignment="HeightAlignment.Center">
                        <StackWeight Weight="null">
                            <div class="ThemeSwitcher RippleEffect"></div>
                        </StackWeight>
                    </HStack>
                </StackWeight>
            </HStack>
        </Pad>
        <main>
            <article>
                <Clamp IsSmall="true">
                    <VStack Sizing="Sizing.Xxl">
                        @Body
                    </VStack>
                </Clamp>
            </article>
        </main>
    </div>
</div>
<div class="backdrop @(isMenuOpen ? "toggle" : "")" @onclick="Close"></div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private Boolean isMenuOpen;

    private void Close() => isMenuOpen = false;
    private void Open() => isMenuOpen = true;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += LocationChanged;
    }

    void LocationChanged(object sender, LocationChangedEventArgs e)
    {
        Close();
        StateHasChanged();
    }

    void IDisposable.Dispose()
    {
        NavigationManager.LocationChanged -= LocationChanged;
    }
}