@using Blazura.Components.Layout
@inherits LayoutComponentBase
@layout RootLayout

@implements IDisposable
@inject NavigationManager NavigationManager

<div class="page @(isMenuOpen ? "toggle" : "")">
    <aside class="@(isMenuOpen ? "toggle" : "")">
        <Sticky>
            <Pad>
                <VStack>
                    <Pad>
                        <Header />
                    </Pad>
                    <NavMenu />
                    <Pad>
                        <Footer />
                    </Pad>
                </VStack>
            </Pad>
        </Sticky>
    </aside>
    <div>
        <Pad Spacing="Spacing.Lg">
            <HStack HeightAlignment="HeightAlignment.Center" StackBehaviour="StackBehaviour.Seperate">
                <StackWeight Weight="null">
                    <div class="sideMenuButton">
                        <IconButton Icon="menu" @onclick="Open" />
                    </div>
                </StackWeight>
                <StackWeight Weight="null">
                    <HStack HeightAlignment="HeightAlignment.Center">
                        <StackWeight Weight="null">
                            <div class="ThemeSwitcher RippleEffect"></div>
                        </StackWeight>
                    </HStack>
                </StackWeight>
            </HStack>
        </Pad>
        <main>
            <article>
                <Clamp IsSmall="true">
                    <VStack Spacing="Spacing.Xxl">
                        @Body
                    </VStack>
                </Clamp>
            </article>
        </main>
    </div>
</div>
<div class="backdrop @(isMenuOpen ? "toggle" : "")" @onclick="Close"></div>

<div id="blazor-error-ui" data-nosnippet>
    <Pad>
        <HStack HeightAlignment="HeightAlignment.Center" Spacing="Spacing.Xs">
            <StackWeight>
                An unhandled error has occurred.
            </StackWeight>
            <StackWeight Weight="null">
                <a href=".">
                    <Button Size="Size.Small" Theme="Theme.Dark">Reload</Button>
                </a>
            </StackWeight>
            <StackWeight Weight="null">
                <span class="dismiss">
                    <Button Size="Size.Small" Theme="Theme.Dark" Style="Style.Glass">
                        <Icon>close</Icon>
                    </Button>
                </span>
            </StackWeight>
        </HStack>
    </Pad>
</div>

@code {
    private Boolean isMenuOpen;

    private void Close() => isMenuOpen = false;
    private void Open() => isMenuOpen = true;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += LocationChanged;
    }

    void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Close();
        StateHasChanged();
    }

    void IDisposable.Dispose()
    {
        NavigationManager.LocationChanged -= LocationChanged;
    }
}