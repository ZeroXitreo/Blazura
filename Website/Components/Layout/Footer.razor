<footer>
    <VStack>
        <ul>
            <li><a href="https://github.com/ZeroXitreo/Blazura" target="_blank">GitHub</a></li>
            <li><a href="https://www.nuget.org/packages/Blazura/" target="_blank">Nuget</a></li>
        </ul>
        <hr />
        <StackWeight>
            Made with &#129505; by ZeroXitreo
        </StackWeight>
        <hr />
        <HStack StackBehaviour="StackBehaviour.Seperate" HeightAlignment="HeightAlignment.Center">
            <StackWeight Weight="null">
                &copy; @DateTime.UtcNow.Year - Blazura
            </StackWeight>
            <StackWeight Weight="null">
                <a href="https://github.com/ZeroXitreo/Blazura/commit/@commitSha">@commitSha?.Substring(0, Math.Min(7, commitSha.Length))</a>
            </StackWeight>
        </HStack>
    </VStack>
</footer>

@code {
    private string? commitSha = Environment.GetEnvironmentVariable("GIT_SHA");
}