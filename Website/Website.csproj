<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="**\*.js" />
		<EmbeddedResource Include="**\*.scss" />
		<EmbeddedResource Include="**\*.razor" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
		<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Blazura\Blazura.csproj" />
	</ItemGroup>
	
	<Target Name="CopyRequiredFiles" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<SourceTSFile Include="..\Blazura\Scripts\IClassBringer.d.ts" />
		</ItemGroup>

		<Message Importance="high" Text="[Blazura] Copying file: @(SourceTSFile) to $(MSBuildProjectDirectory)\Scripts\IClassBringer.d.ts" />
		<Copy SourceFiles="@(SourceTSFile)" DestinationFiles="$(MSBuildProjectDirectory)\Scripts\IClassBringer.d.ts" SkipUnchangedFiles="false" />

		<Message Importance="high" Text="[Blazura] Copying file: ..\Blazura\Scripts\ClassBringer.d.ts.copy to $(MSBuildProjectDirectory)\Scripts\ClassBringer.d.ts" />
		<Copy SourceFiles="..\Blazura\Scripts\ClassBringer.d.ts.copy" DestinationFiles="$(MSBuildProjectDirectory)\Scripts\ClassBringer.d.ts" SkipUnchangedFiles="false" />

		<Message Importance="high" Text="[Blazura] Copying file: ..\Blazura\Styles\Root.scss to $(MSBuildProjectDirectory)\Styles\Root.scss" />
		<Copy SourceFiles="..\Blazura\Styles\Root.scss" DestinationFiles="$(MSBuildProjectDirectory)\Styles\Root.scss" SkipUnchangedFiles="false" />
		
		<Message Importance="high" Text="[Blazura] Copying file: ..\Blazura\tsconfig.json to $(MSBuildProjectDirectory)\tsconfig.json" />
		<Copy SourceFiles="..\Blazura\tsconfig.json" DestinationFiles="$(MSBuildProjectDirectory)\tsconfig.json" SkipUnchangedFiles="false" />
	</Target>

</Project>
