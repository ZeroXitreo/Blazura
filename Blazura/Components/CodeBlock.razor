<div class="CodeBlock @(Color.ToString())">
    <div class="content">
        <style>
                    pre {
                        overflow-x: auto;
                        white-space: pre;
                        position: initial;
                        overflow-x: auto;
                    }

                    code {
                        /* white-space: pre-wrap; */
                        word-break: break-word;
                        overflow-wrap: anywhere;
                    }
        </style>
        <pre>
            <code>
                @ChildContent
            </code>
        </pre>
    </div>
</div>

