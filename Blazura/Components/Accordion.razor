@using Microsoft.JSInterop

@inject IJSRuntime JSRuntime

<div class="Accordion @(IsOpen ? "open" : null)">
    <div class="title" @onclick="AttemptToggle">
        <Pad>
            @Title
        </Pad>
    </div>
    <div class="content" id="accordion-@this.GetHashCode()">
        <Pad Sides="Side.LeftRight | Side.Bottom">
            @ChildContent
        </Pad>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool IsOpen { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnToggle { get; set; }

    private async Task AttemptToggle()
    {
        IsOpen = !IsOpen;
        TriggerToggle();
        await OnToggle.InvokeAsync(IsOpen);
    }

    private void TriggerToggle()
    {
        JSRuntime.InvokeVoidAsync(IsOpen ? "openAccordion" : "closeAccordion", "accordion-" + this.GetHashCode());
    }
}
