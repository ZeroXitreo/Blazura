<div class="Accordion @(IsOpen ? "open" : null)">
    <div class="title" @onclick="TryToOpen">
        <Pad>
            @Title
        </Pad>
    </div>
    <div class="content">
        <Pad Sides="Side.LeftRight | Side.Bottom">
            @ChildContent
        </Pad>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool IsOpen { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnToggle { get; set; }

    private async Task TryToOpen()
    {
        IsOpen = !IsOpen;
        await OnToggle.InvokeAsync(IsOpen);
    }
}
