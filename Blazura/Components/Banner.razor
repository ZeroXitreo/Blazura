<div class="BlazuraBanner @(Color.ToString())">
    <Pad>
        <HStack StackBehaviour="StackBehaviour.Seperate" HeightAlignment="HeightAlignment.Stretch">
            @if (IncludeIcon)
            {
                <StackWeight Weight="0">
                    <div>
                        <div class="iconHolder">
                            @switch (Color)
                            {
                                case Color.Success:
                                    <Icon>check</Icon>
                                    break;
                                case Color.Info:
                                    <Icon>info</Icon>
                                    break;
                                case Color.Warning:
                                    <Icon>warning</Icon>
                                    break;
                                case Color.Error:
                                    <Icon>error</Icon>
                                    break;
                                default:
                                    <Icon>help</Icon>
                                    break;
                            }
                        </div>
                    </div>
                </StackWeight>
            }
            <HStack HeightAlignment="HeightAlignment.Center">
                <VStack Spacing="Spacing.Xs">
                    @if (Title is not null)
                    {
                        <div class="title">@Title</div>
                    }
                    @if (ChildContent is not null)
                    {
                        <div>
                            @ChildContent
                        </div>
                    }
                </VStack>
            </HStack>
        </HStack>
    </Pad>
</div>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public bool IncludeIcon { get; set; } = true;
}
