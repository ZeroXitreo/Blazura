<div class="State">
    <VStack>
        <div class="stateIcon">
            <Icon>@Icon</Icon>
        </div>
        <div class="title">@Title</div>
        @if (ChildContent is not null)
        {
            <div class="description">@ChildContent</div>
        }
    </VStack>
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = "indeterminate_question_box";

    [Parameter]
    [EditorRequired]
    public string Title { get; set; }

    [Parameter]
    public required RenderFragment ChildContent { get; set; }
}