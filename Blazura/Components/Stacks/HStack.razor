@namespace Blazura.Components

<div class="HStack @(Spacing.ToString()) @(HeightAlignment.ToString()) StackBehaviour@(StackBehaviour.ToString())">
	@ChildContent
</div>

@code {
	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public Spacing Spacing { get; set; } = Spacing.Md;

	[Parameter]
	public HeightAlignment HeightAlignment { get; set; } = HeightAlignment.Stretch;

	[Parameter]
	public StackBehaviour StackBehaviour { get; set; } = StackBehaviour.Left;
}
