<div class="Tooltip">
    <div>@ChildContent</div>
    <div class="TooltipAnchor @(Anchor.ToString())">
        <div class="TooltipContainer">
            <Pad Spacing="Spacing.Sm">
                <VStack Spacing="Spacing.Sm">
                    @if (ImageSrc is not null)
                    {
                        <img src="@ImageSrc" class="TooltipImage" />
                    }
                    <VStack Spacing="Spacing.Xxs">
                        @if (Title is not null)
                        {
                            <div class="TooltipTitle">@Title</div>
                        }
                        @if (Description is not null)
                        {
                            <div class="TooltipDescription">@Description</div>
                        }
                    </VStack>
                </VStack>
            </Pad>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? ImageSrc { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public Anchor Anchor { get; set; } = Anchor.Bottom;
}
