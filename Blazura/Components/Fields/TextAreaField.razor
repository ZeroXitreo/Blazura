@using Microsoft.Extensions.DependencyInjection
@namespace Blazura.Components
@inherits InputTextArea
@inject IServiceProvider ServiceProvider

<Placeholder For="@ValueExpression" Format="@Format">
    <InputTextArea Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" @attributes="AdditionalAttributes" />
</Placeholder>

@code {
    [Parameter] public Func<string, string> Format { get; set; } = (str) => str;

    private IFieldFormat? FieldFormat;

    protected override void OnInitialized()
    {
        FieldFormat = ServiceProvider.GetService<IFieldFormat>();
        Format = FieldFormat?.Format ?? Format;
    }
}