@using Microsoft.Extensions.DependencyInjection
@namespace Blazura.Components
@inherits InputText
@inject IServiceProvider ServiceProvider

<Placeholder For="@ValueExpression" Format="@Format" FieldSize="FieldSize">
    <InputText Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" @attributes="AdditionalAttributes" />
</Placeholder>

@code {
    [Parameter]
    public Func<string, string> Format { get; set; } = (str) => str;

    [Parameter]
    public FieldSize FieldSize { get; set; }

    private IFieldFormat? FieldFormat;

    protected override void OnInitialized()
    {
        FieldFormat = ServiceProvider.GetService<IFieldFormat>();
        Format = FieldFormat?.Format ?? Format;
    }
}